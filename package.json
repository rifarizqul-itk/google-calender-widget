{
  "name": "google-calender-widget",
  "version": "1.5.5",
  "main": "index.js",
  "description": "An unofficial google calendar desktop widget for Windows, Mac and Linux",
  "license": "MIT",
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^25.0.5",
    "nodemon": "^3.0.1"
  },
  "dependencies": {
    "electron-is-dev": "^2.0.0",
    "googleapis": "^176.0.0"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "pack": "electron-builder --dir",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "p32929.google-calender-widget",
    "productName": "google-calender-widget",
    "files": [
      "index.js",
      "package.json",
      "src/**/*",
      "resources/**/*"
    ],
    "extraResources": [
      {
        "from": "./resources/",
        "to": "./"
      },
      {
        "from": "./",
        "to": "./",
        "filter": [
          "client_secret*.json"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "resources/icon.png"
    },
    "mac": {
      "category": "p32929.google-calender-widget",
      "icon": "resources/icon.png"
    },
    "linux": {
      "category": "p32929.google-calender-widget",
      "icon": "resources/icon.png",
      "target": {
        "target": "appimage",
        "arch": [
          "x64"
        ]
      }
    }
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
